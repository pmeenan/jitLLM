{
  "version": 10,
  "$comment": [
    "Build profiles (D-011, D-026, D-032). Every preset needs JITLLM_SDK, the pinned SDK's root, and that SDK's cmake; `mise run build`, `test` and `deploy` (tools/build) supply both.",
    "Test presets skip the `gpu` label except where a GB10 is present: spark-native, and cross-remote, with which `mise run test -- cross --host HOST` runs the deployed cross build's tests on a Spark over SSH."
  ],
  "cmakeMinimumRequired": {"major": 4, "minor": 4, "patch": 3},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "native",
      "inherits": "base",
      "displayName": "x86-64 native, CUDA for sm_121",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu-native.cmake",
      "cacheVariables": {"JITLLM_CUDA": "ON"}
    },
    {
      "name": "cpu",
      "inherits": "base",
      "displayName": "x86-64 native, CPU only (no CUDA toolkit)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu-native.cmake",
      "cacheVariables": {"JITLLM_CUDA": "OFF"}
    },
    {
      "name": "cross",
      "inherits": "base",
      "displayName": "AArch64 cross build for DGX Spark, CUDA for sm_121",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu-cross.cmake",
      "cacheVariables": {"JITLLM_CUDA": "ON"}
    },
    {
      "name": "spark-native",
      "inherits": "base",
      "displayName": "Native build on a DGX Spark (diagnostic fallback)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu-native.cmake",
      "cacheVariables": {"JITLLM_CUDA": "ON"}
    },
    {
      "name": "cpu-asan",
      "inherits": "cpu",
      "displayName": "x86-64 native, CPU only, ASan+UBSan with leak detection",
      "cacheVariables": {"JITLLM_SANITIZE": "address;undefined"}
    },
    {
      "name": "cross-asan",
      "inherits": "cross",
      "displayName": "AArch64 cross build, ASan+UBSan (leak detection only on a Spark)",
      "cacheVariables": {"JITLLM_SANITIZE": "address;undefined"}
    },
    {
      "name": "cross-tsan",
      "inherits": "cross",
      "displayName": "AArch64 cross build, ThreadSanitizer (tests run only on a Spark)",
      "cacheVariables": {"JITLLM_SANITIZE": "thread"}
    }
  ],
  "buildPresets": [
    {"name": "native", "configurePreset": "native"},
    {"name": "cpu", "configurePreset": "cpu"},
    {"name": "cross", "configurePreset": "cross"},
    {"name": "spark-native", "configurePreset": "spark-native"},
    {"name": "cpu-asan", "configurePreset": "cpu-asan"},
    {"name": "cross-asan", "configurePreset": "cross-asan"},
    {"name": "cross-tsan", "configurePreset": "cross-tsan"}
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error"}
    },
    {
      "name": "no-gpu",
      "hidden": true,
      "inherits": "base",
      "filter": {"exclude": {"label": "gpu"}}
    },
    {"name": "native", "inherits": "no-gpu", "configurePreset": "native"},
    {"name": "cpu", "inherits": "no-gpu", "configurePreset": "cpu"},
    {"name": "cross", "inherits": "no-gpu", "configurePreset": "cross"},
    {"name": "cross-remote", "inherits": "base", "configurePreset": "cross"},
    {"name": "spark-native", "inherits": "base", "configurePreset": "spark-native"},
    {
      "name": "cpu-asan",
      "inherits": "no-gpu",
      "configurePreset": "cpu-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1",
        "ASAN_SYMBOLIZER_PATH": "$env{JITLLM_SDK}/bin/llvm-symbolizer"
      }
    },
    {
      "name": "cross-asan",
      "inherits": "no-gpu",
      "configurePreset": "cross-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "UBSAN_OPTIONS": "print_stacktrace=1",
        "ASAN_SYMBOLIZER_PATH": "$env{JITLLM_SDK}/bin/llvm-symbolizer"
      }
    },
    {
      "name": "cross-asan-remote",
      "inherits": "base",
      "configurePreset": "cross-asan",
      "environment": {"ASAN_OPTIONS": "detect_leaks=1", "UBSAN_OPTIONS": "print_stacktrace=1"}
    },
    {
      "name": "cross-tsan-remote",
      "inherits": "base",
      "configurePreset": "cross-tsan",
      "environment": {"TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"}
    }
  ]
}
