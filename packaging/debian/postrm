#!/bin/sh
# SPDX-FileCopyrightText: 2026 jitLLM contributors
# SPDX-License-Identifier: Apache-2.0
#
# The jitllm package's postrm. Removing or purging the package keeps
# /var/lib/jitllm, /etc/jitllm and the jitllm user: installed models,
# records and configuration are the owner's to delete.
set -e

if [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = purge ] && [ -z "$DPKG_ROOT" ]; then
  if [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper purge jitllm.service >/dev/null || true
    deb-systemd-helper unmask jitllm.service >/dev/null || true
  fi
fi
exit 0
