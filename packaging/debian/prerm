#!/bin/sh
# SPDX-FileCopyrightText: 2026 jitLLM contributors
# SPDX-License-Identifier: Apache-2.0
#
# The jitllm package's prerm: stop the runtime (which drains) before its
# files go away.
set -e

if [ -z "$DPKG_ROOT" ] && [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  deb-systemd-invoke stop jitllm.service >/dev/null || true
fi
exit 0
