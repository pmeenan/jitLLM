#
# The jitLLM node runtime (D-005, D-063, D-074). Override settings with a
# drop-in (`systemctl edit jitllm`), for example ReadWritePaths= for a
# storage role outside /var/lib/jitllm, rather than editing this file.

[Unit]
Description=jitLLM node runtime
Documentation=https://github.com/pmeenan/jitLLM
After=local-fs.target network.target nvidia-persistenced.service
# A host that stays unready (exit 75) is given up on after ten tries in five
# minutes.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/jitllm/jitllm-runtime
User=jitllm
Group=jitllm

# Restarted after a crash, and after exit 75 (the driver or its devices not
# ready, as at boot), but not after exit 78 (the configuration, the storage
# roles or the process lock), which a restart would only repeat; `jitllm
# doctor` says why.
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=78
# Stop means drain (D-027); SIGTERM starts it.
KillMode=control-group
TimeoutStopSec=90s

# /etc/jitllm (root-owned), /var/lib/jitllm and /run/jitllm (the runtime's).
ConfigurationDirectory=jitllm
StateDirectory=jitllm
StateDirectoryMode=0755
RuntimeDirectory=jitllm
UMask=0077

# Job processes (import, install, archive) run in cgroups the runtime makes
# beside its own (D-074): it runs in .../jitllm.service/runtime.
Delegate=memory pids cpu io
DelegateSubgroup=runtime

# Crashes leave no core image (D-014); the runtime also refuses to dump.
LimitCORE=0
# RDMA memory registration (D-063).
LimitMEMLOCK=infinity

# Sandboxing. Everything but /var/lib/jitllm and /run/jitllm is read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# Only the GPU and RDMA device nodes, besides the standard pseudo-devices.
DevicePolicy=closed
# char-nvidia is major 195: /dev/nvidia0 and /dev/nvidiactl.
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps r
DeviceAllow=char-infiniband_verbs rw
DeviceAllow=/dev/infiniband/rdma_cm rw

[Install]
WantedBy=multi-user.target
