jitLLM adaptations of the pinned GGML sources (D-053, D-077), active only
when GGML_JITLLM is defined (third_party/patches/ggml/0002-jitllm-build.patch
defines it):

- ggml.c: ggml_print_backtrace does nothing, so ggml_abort prints its
  message and aborts without forking or executing a debugger.
- ggml-cuda/common.cuh: ggml_cuda_error is not [[noreturn]]. jitLLM defines
  it (src/kernels/ggml/) to record the failure and return, so a launcher
  returns and its caller reports the error instead of the process aborting.
- ggml-cuda/common.cuh: kernel launches use programmatic dependent launch
  as the build decides, without reading GGML_CUDA_PDL from the environment.

diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 5ef03e1..382d55f 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -156,6 +156,10 @@ static void ggml_print_backtrace_symbols(void) {
 #endif
 
 void ggml_print_backtrace(void) {
+#if defined(GGML_JITLLM)
+    // jitLLM: a served process never forks or execs a debugger. ggml_abort
+    // still prints its message and aborts.
+#else
     const char * GGML_NO_BACKTRACE = getenv("GGML_NO_BACKTRACE");
     if (GGML_NO_BACKTRACE) {
         return;
@@ -234,6 +238,7 @@ void ggml_print_backtrace(void) {
 #endif
         waitpid(child_pid, NULL, 0);
     }
+#endif // !defined(GGML_JITLLM)
 }
 #else
 void ggml_print_backtrace(void) {
